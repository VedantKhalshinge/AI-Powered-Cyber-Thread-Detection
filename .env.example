# Environment Variables — copy to .env and fill in values

# Groq API key for NLP-powered alert generation
# Get yours at: https://console.groq.com/
GROQ_API_KEY=

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-me-to-a-strong-random-key

# Alert thresholds (0.0 - 1.0)
# Detection scores above these thresholds trigger NLP alert generation
ALERT_THRESHOLD_ANOMALY=0.7
ALERT_THRESHOLD_MALWARE=0.8
ALERT_THRESHOLD_PHISHING=0.75
